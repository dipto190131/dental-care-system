# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/dentalcare

# DJANGO
DJANGO_SETTINGS_MODULE=dental_care.settings
DJANGO_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
DJANGO_DEBUG=False

# DJANGO BACKEND HOST/PORT (for Express proxy)
# Default: localhost:8000
# On Railway: point to external Django service or use localhost if running together
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000

# EXPRESS
PORT=5000
NODE_ENV=production

# AI APIs (Optional)
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here

# CORS & SECURITY
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.railway.app
